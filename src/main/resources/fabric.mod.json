{
  "schemaVersion": 1,
  "id": "customrecipe",
  "version": "${version}",
  "name": "Custom Recipe",
  "description": "Create and manage shaped or shapeless recipes in game. Includes built-ins, vanilla recipe controls, material variants, and OP server configuration.",
  "authors": [
    "Zazac1"
  ],
  "contact": {
    "homepage": "https://github.com/Zazac1/CustomRecipe",
    "sources":  "https://github.com/Zazac1/CustomRecipe",
    "issues":   "https://github.com/Zazac1/CustomRecipe/issues"
  },
  "license": "MIT",
  "icon": "assets/customrecipe/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "fr.isaac.customrecipe.CustomRecipeMod"
    ],
    "client": [
      "fr.isaac.customrecipe.client.ClientInit"
    ],
    "modmenu": [
      "fr.isaac.customrecipe.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "customrecipe.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.5",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
